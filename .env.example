# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=legal_ai_db
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_password_here@db:5432/legal_ai_db

# Environment & Security
ENVIRONMENT=production
ALLOWED_ORIGINS=["https://yourdomain.com"]

# JWT Secrets (Generate secure random keys in production)
JWT_SECRET_KEY=your_super_secret_jwt_hmac_key_here
JWT_REFRESH_SECRET_KEY=your_super_secret_refresh_hmac_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# LLM Routing & API Keys
DEFAULT_LLM_PROVIDER=groq
LLM_TIMEOUT_SECONDS=30

GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3

GEMINI_API_KEY=AIza_your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Embedding & RAG Parameters
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=4

# Voice Settings
ENABLE_TTS=false
WHISPER_PROVIDER=groq